{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:lintra:authoring:manifest:1",
  "title": "Lintra bundle manifest — human review draft",
  "type": "object",
  "properties": {
    "bundle_version": {
      "type": "string",
      "minLength": 1
    },
    "schema_format_version": {
      "const": 1,
      "type": "integer"
    },
    "files": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "type": "string",
        "pattern": "^(?!/)(?!.*[\\x00-\\x1f\\x7f])(?!.*\\\\)(?!.*:)(?!.*(?:^|/)\\.{1,2}(?:/|$))[^/]+(?:/[^/]+)*$"
      },
      "additionalProperties": {
        "type": "string",
        "pattern": "^[a-f0-9]{64}$"
      }
    }
  },
  "required": [
    "bundle_version",
    "schema_format_version",
    "files"
  ],
  "additionalProperties": false
}
