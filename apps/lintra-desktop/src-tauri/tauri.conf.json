{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Lintra",
  "version": "0.1.1-rc.3",
  "identifier": "it.lintra.desktop",
  "build": {
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{
      "label": "main",
      "create": false,
      "title": "Lintra",
      "width": 1100,
      "height": 760,
      "minWidth": 640,
      "minHeight": 480,
      "devtools": false
    }],
    "security": {
      "csp": "default-src 'none'; script-src 'self'; style-src 'self'; font-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self'; object-src 'none'; base-uri 'none'; frame-src 'none'; form-action 'none'",
      "capabilities": ["desktop"]
    }
  },
  "bundle": { "active": false, "icon": ["icons/128x128.png"] }
}
