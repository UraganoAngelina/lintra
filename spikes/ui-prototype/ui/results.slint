import { ListView } from "std-widgets.slint";
import { Tok } from "tokens.slint";

export struct ErrorRow {
    line: string,
    record: string,
    field: string,
    code: string,
    severity: int,
    message: string,
    code-name: string,
    position: string,
    actual: string,
    expected: string,
    context: string,
    detail: string,
}

component Btn inherits Rectangle {
    in property <string> label;
    in property <bool> primary: false;
    callback clicked();
    height: 36px;
    border-radius: 6px;
    background: root.primary ? Tok.accent : Tok.surface;
    border-width: root.primary ? 0px : 1px;
    border-color: Tok.border;
    HorizontalLayout {
        padding-left: root.primary ? 16px : 14px;
        padding-right: root.primary ? 16px : 14px;
        Text {
            text: root.label;
            color: root.primary ? white : Tok.ink;
            font-weight: root.primary ? 600 : 400;
            vertical-alignment: center;
        }
    }
    TouchArea { clicked => { root.clicked(); } }
}

component FilterInput inherits Rectangle {
    in property <string> placeholder;
    height: 34px;
    background: Tok.surface;
    border-width: 1px;
    border-color: Tok.border;
    border-radius: 6px;
    ti := TextInput {
        x: 10px;
        width: parent.width - 20px;
        height: parent.height;
        vertical-alignment: center;
        color: Tok.ink;
    }
    if ti.text == "": Text {
        x: 10px;
        width: parent.width - 20px;
        height: parent.height;
        vertical-alignment: center;
        text: root.placeholder;
        color: #757575;
    }
}

component FilterSelect inherits Rectangle {
    in property <string> label;
    height: 34px;
    background: Tok.surface;
    border-width: 1px;
    border-color: Tok.border;
    border-radius: 6px;
    Text { x: 10px; height: parent.height; vertical-alignment: center; text: root.label; color: Tok.ink; }
    Path {
        x: parent.width - 22px;
        y: (parent.height - 5px) / 2;
        width: 10px;
        height: 5px;
        viewbox-width: 10;
        viewbox-height: 5;
        commands: "M 0 0 L 5 5 L 10 0";
        stroke: Tok.ink;
        stroke-width: 1.5px;
    }
}

component Stat inherits HorizontalLayout {
    in property <string> label;
    in property <string> value;
    spacing: 0px;
    Text { text: root.label; font-family: Tok.mono; vertical-alignment: center; }
    Text { text: root.value; font-family: Tok.mono; font-weight: 600; vertical-alignment: center; }
}

component KV inherits HorizontalLayout {
    in property <string> label;
    in property <string> value;
    spacing: 0px;
    alignment: start;
    Text { text: root.label; color: Tok.muted; font-family: Tok.mono; font-size: 13px; vertical-alignment: center; horizontal-stretch: 0; }
    Text { text: root.value; color: Tok.ink; font-family: Tok.mono; font-size: 13px; vertical-alignment: center; }
}

export component ResultsWindow inherits Window {
    in property <[ErrorRow]> rows;
    in property <string> table-note: "Righe 1–4 di 411 · l'ordine è lo stesso del file JSONL e dell'XLSX.";
    in-out property <int> selected: 0;

    width: 1280px;
    height: 780px;
    background: Tok.bg;
    default-font-family: Tok.sans;
    default-font-size: 14px;

    VerticalLayout {
        // Intestazione
        Rectangle {
            height: 56px;
            background: Tok.ink;
            HorizontalLayout {
                padding-left: 24px;
                padding-right: 24px;
                spacing: 16px;
                Text { text: "Lintra"; font-size: 20px; font-weight: 700; letter-spacing: 0.5px; color: white; vertical-alignment: center; }
                Text { text: "Risultati dell'analisi"; color: Tok.muted-on-dark; vertical-alignment: center; }
                Rectangle { horizontal-stretch: 1; }
                Text {
                    text: "SIOC · tracciato 2 · schema 2025-12-16 · dati incorporati · hash [schema_hash]";
                    font-family: Tok.mono;
                    font-size: 12px;
                    color: Tok.muted-on-dark;
                    vertical-alignment: center;
                }
            }
        }

        // Riepilogo ed export
        HorizontalLayout {
            height: 52px;
            padding-top: 16px;
            padding-left: 24px;
            padding-right: 24px;
            spacing: 12px;
            Rectangle {
                height: 30px;
                y: 3px;
                background: Tok.error-tint;
                border-radius: 6px;
                HorizontalLayout {
                    padding-left: 12px;
                    padding-right: 12px;
                    Text { text: "NON CONFORME"; color: Tok.error; font-weight: 700; vertical-alignment: center; }
                }
            }
            Stat { label: "Record: "; value: "125.430"; }
            Stat { label: "Record non validi: "; value: "318"; }
            Stat { label: "Errori: "; value: "411"; }
            Stat { label: "Tempo: "; value: "00:09"; }
            Rectangle { horizontal-stretch: 1; }
            Btn { label: "Esporta XLSX"; primary: true; }
            Btn { label: "JSONL"; }
            Btn { label: "CSV"; }
        }

        // Area principale
        Rectangle {
            vertical-stretch: 1;
            VerticalLayout {
                alignment: start;
                HorizontalLayout {
                    padding-top: 16px;
                    padding-bottom: 16px;
                    padding-left: 24px;
                    padding-right: 24px;
                    spacing: 16px;

                    // Pannello tabella
                    VerticalLayout {
                        width: Tok.table-width;
                        horizontal-stretch: 0;
                        alignment: start;
                        Rectangle {
                            background: Tok.surface;
                            border-width: 1px;
                            border-color: Tok.border;
                            border-radius: 8px;
                            VerticalLayout {
                                padding: 16px;
                                spacing: 12px;
                                HorizontalLayout {
                                    spacing: 8px;
                                    alignment: start;
                                    FilterSelect { label: "Tutti i codici"; width: Tok.filter-code-width; }
                                    FilterInput { placeholder: "Field ID (es. 2.29)"; width: Tok.filter-field-width; }
                                    FilterInput { placeholder: "ID record"; width: Tok.filter-record-width; }
                                    FilterInput { placeholder: "Codice Fiscale"; width: Tok.filter-fiscal-width; }
                                    FilterInput { placeholder: "Riga"; width: Tok.filter-line-width; }
                                }
                                // Header and rows are one contiguous table;
                                // the old outer spacing inserted a false gap.
                                VerticalLayout {
                                spacing: 0px;
                                // Intestazione tabella
                                Rectangle {
                                    height: 34px;
                                    background: Tok.header-bg;
                                    HorizontalLayout {
                                        padding: 8px;
                                        spacing: 8px;
                                        Text { width: 70px; text: "Riga"; font-size: 13px; font-weight: 600; vertical-alignment: center; }
                                        Text { width: 110px; text: "ID record"; font-size: 13px; font-weight: 600; vertical-alignment: center; }
                                        Text { width: 70px; text: "Campo"; font-size: 13px; font-weight: 600; vertical-alignment: center; }
                                        Text { width: 90px; text: "Codice"; font-size: 13px; font-weight: 600; vertical-alignment: center; }
                                        Text { horizontal-stretch: 1; text: "Messaggio"; font-size: 13px; font-weight: 600; vertical-alignment: center; }
                                    }
                                }
                                // Righe (virtualizzate)
                                ListView {
                                    min-height: 100px;
                                    preferred-height: root.rows.length * 34px;
                                    for row[i] in root.rows: Rectangle {
                                        height: 34px;
                                        background: i == root.selected ? Tok.accent-tint : transparent;
                                        Rectangle {
                                            y: parent.height - 1px;
                                            height: 1px;
                                            background: i == root.selected ? transparent : Tok.row-line;
                                        }
                                        if i == root.selected: Rectangle {
                                            x: 0px;
                                            width: 3px;
                                            background: Tok.accent;
                                        }
                                        HorizontalLayout {
                                            padding-top: 8px;
                                            padding-bottom: 8px;
                                            padding-right: 8px;
                                            padding-left: i == root.selected ? 11px : 8px;
                                            spacing: 8px;
                                            Text { width: 70px; text: row.line; font-family: Tok.mono; font-size: 13px; vertical-alignment: center; }
                                            Text { width: 110px; text: row.record; font-family: Tok.mono; font-size: 13px; vertical-alignment: center; }
                                            Text { width: 70px; text: row.field; font-family: Tok.mono; font-size: 13px; vertical-alignment: center; }
                                            Text {
                                                width: 90px;
                                                text: row.code;
                                                font-family: Tok.mono;
                                                font-size: 13px;
                                                color: row.severity == 0 ? Tok.error : Tok.warn;
                                                vertical-alignment: center;
                                            }
                                            Text { horizontal-stretch: 1; text: row.message; font-size: 13px; vertical-alignment: center; overflow: elide; }
                                        }
                                        TouchArea { clicked => { root.selected = i; } }
                                    }
                                }
                                }
                                Text { text: root.table-note; font-size: 12px; color: Tok.muted; }
                            }
                        }
                    }

                    // Pannello dettaglio
                    VerticalLayout {
                        width: Tok.detail-width;
                        horizontal-stretch: 0;
                        alignment: start;
                        Rectangle {
                            background: Tok.surface;
                            border-width: 1px;
                            border-color: Tok.border;
                            border-radius: 8px;
                            VerticalLayout {
                                padding: 16px;
                                spacing: Tok.detail-section-spacing;
                                Text { text: "Dettaglio errore"; font-size: 16px; font-weight: 600; }
                                VerticalLayout {
                                    spacing: Tok.detail-meta-spacing;
                                    KV { label: "Codice "; value: root.rows[root.selected].code-name; }
                                    KV { label: "Riga "; value: root.rows[root.selected].line + " · " + root.rows[root.selected].record; }
                                    KV { label: "Campo "; value: root.rows[root.selected].field + " · posizione " + root.rows[root.selected].position; }
                                    KV { label: "Letto "; value: root.rows[root.selected].actual; }
                                    KV { label: "Atteso "; value: root.rows[root.selected].expected; }
                                    KV { label: "Contesto "; value: root.rows[root.selected].context; }
                                }
                                Text { text: root.rows[root.selected].detail; wrap: word-wrap; color: Tok.ink; line-height-factor: Tok.detail-line-height-factor; }
                            }
                        }
                    }
                }
            }
        }

        // Nota a piè di pagina
        Text {
            text: "Dati di esempio a scopo illustrativo.";
            font-size: 12px;
            color: Tok.muted;
            height: 28px;
            x: 24px;
        }
    }
}
