* text=auto
tests/fixtures/** -text
tests/golden/** -text
# Fixed-width fixture padding/CRLF are data, not source-style whitespace errors.
tests/golden/synthetic/**/input.txt -whitespace
docs/schema-authoring/examples/** -text
# Embedded synthetic assets and manifest hashes must survive checkout unchanged.
bundles/embedded/** -text
# Preserve approved SIOC provenance and new derived artifacts byte-for-byte.
schemas/sioc/2026-04-20.structural-minimal.1/flow_schema.json -text
schemas/sioc/2026-04-20.structural-minimal.1/scope-ledger.json -text
docs/normative/sioc/rules-and-joins.md -text
schemas/sioc/2026-04-20.structural-minimal.2/** -text
# Synthetic cross-trace records contain intentional fixed-width space padding.
tests/golden/cross-trace/**/*.dat -whitespace

# UI source visual truth and embedded fonts retain their original bytes.
spikes/ui-prototype/tests/reference/*.png -text
spikes/ui-prototype/ui/fonts/*.ttf -text
# UI archives carry these exact repository bytes on both native runners.
# Prevent core.autocrlf from changing their digests on a Windows checkout.
ui/ui/fonts/OFL.md text eol=lf
ui/licenses/SLINT-ROYALTY-FREE-2.0.md text eol=lf

# Approved CAD source datasets and hashed membership assets retain exact bytes.
schemas/cad/components/2024-06.clinical-lookups.1/source/** -text
schemas/cad/components/2024-06.clinical-lookups.1/data/** -text
# Progressive provenance cites these exact versioned component bytes.
schemas/cad/components/2024-06.namespace.1/component.json -text
schemas/cad/components/2024-06.progressives.1/component.json -text
# Executable CAD profile and its membership hashes are portable data artifacts.
schemas/operational/CAD/** -text
tests/golden/cad83/**/*.dat -whitespace
