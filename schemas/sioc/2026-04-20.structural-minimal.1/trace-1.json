      "regulatory_metadata": {
        "source_id": "1.12",
        "source_key_marker": false,
        "source_obligation": "OBB",
        "source_note": "Titolo di studio conseguito dall’utente al momento dell’ammissione.\nValori ammessi:\n1 . Nessun titolo (meno di 5 anni di studio) \n2. Licenza elementare (5 anni di studio) \n3. Diploma di scuola media inferiore (8 anni di studio) \n4. Diploma di scuola media superiore (Qualifica professionale / Maturità) (13 anni di studio) \n5. Diploma universitario o laurea breve \n6. Laurea o superiore (17 o più anni di studio)\n7. scuola professionale\n9. sconosciuto"
      }
    },
