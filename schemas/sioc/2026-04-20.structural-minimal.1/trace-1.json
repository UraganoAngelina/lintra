      "name": "Numero della scheda di ricovero (ex Identificativo univoco assistito per episodio di accoglimento)",
      "physical": {
        "start": 1,
        "length": 20,
        "type": "alphanumeric",
        "alignment": {
          "kind": "right_pad",
          "fill_byte": 32,
