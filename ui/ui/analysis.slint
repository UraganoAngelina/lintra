import { ScrollView } from "std-widgets.slint";
import { Tok } from "tokens.slint";
import { ActionButton, FieldEdit, ChoiceBox, ReportCheck } from "controls.slint";

export struct BrowserItem { label: string, directory: bool, selectable: bool }

export component AnalysisForm inherits Rectangle {
    in property <[string]> flows;
    in property <[string]> versions;
    in property <[string]> traces;
    in-out property <int> flow-index: -1;
    in-out property <int> version-index: -1;
    in-out property <int> trace-index: -1;
    in-out property <int> encoding-index: -1;
    in-out property <string> file-path;
    in-out property <bool> report-jsonl: true;
    in-out property <bool> report-xlsx: true;
    in-out property <bool> report-csv: false;
    in property <string> preview-note: "Seleziona un file per il controllo preliminare.";
    in property <string> status-note: "Scegli file, flusso, versione, tracciato ed encoding.";
    in property <string> origin-label;
    in property <string> schema-label;
    in property <bool> configuration-error: false;
    in property <bool> bundle-ready: false;
    in property <bool> ready: false;
    in property <string> execution-label: "Analisi non avviata";
    in property <string> execution-detail;
    in property <bool> validation-invalid: false;
    in property <bool> execution-partial: false;
    in property <bool> busy: false;
    in property <bool> worker-available: false;
    callback file-edited(string);
    callback file-confirmed(string);
    callback browse();
    callback choose-flow(int);
    callback choose-version(int);
    callback choose-trace(int);
    callback choose-encoding(int);
    callback reports-changed();
    callback start-analysis();
    callback cancel-analysis();
    // Compact windows stack the same panels; no separate flow-specific UI.
    property <bool> narrow: root.width < Tok.form-breakpoint;
    property <length> content-width: root.width - Tok.page-padding * 2;
    property <length> configuration-width: root.narrow ? root.content-width : (root.content-width - Tok.panel-gap) * 0.60;
    background: Tok.bg;
    Flickable {
        content-width: root.width;
        content-height: root.narrow ? Tok.analysis-intro-height + config.height + run.height + Tok.page-padding * 2 : Tok.analysis-intro-height + max(config.height, run.height) + Tok.page-padding;
        Text {
            x: Tok.page-padding; y: Tok.page-padding;
            text: "Nuova analisi"; color: Tok.ink;
            font-size: Tok.title-size; font-weight: Tok.semibold-weight;
        }
        Text {
            x: Tok.page-padding; y: 66px;
            width: root.content-width;
            text: "Prepara il file e scegli lo schema per la validazione.";
            color: Tok.muted; wrap: word-wrap;
        }
        config := Rectangle {
            x: Tok.page-padding; y: Tok.analysis-intro-height;
            width: root.configuration-width; height: Tok.configuration-height;
            background: Tok.surface; border-width: Tok.border-width;
            border-color: Tok.border; border-radius: Tok.card-radius;
            Text { x: Tok.card-padding; y: Tok.card-padding; text: "Configurazione"; color: Tok.ink; font-size: Tok.section-size; font-weight: Tok.semibold-weight; }
            Text { x: Tok.card-padding; y: 64px; text: "File di input · larghezza fissa"; color: Tok.ink; font-weight: Tok.semibold-weight; }
            FieldEdit {
                x: Tok.card-padding; y: 88px;
                width: parent.width - Tok.card-padding * 2 - Tok.chooser-width - Tok.picker-gap;
                text <=> root.file-path; placeholder: "Percorso del file · Invio per verificare";
                enabled: !root.busy; monospace: true;
                edited(value) => { root.file-edited(value); }
                confirmed(value) => { root.file-confirmed(value); }
            }
            ActionButton {
                x: parent.width - Tok.card-padding - Tok.chooser-width; y: 88px;
                width: Tok.chooser-width; label: "Sfoglia"; enabled: !root.busy;
                activated => { root.browse(); }
            }
            Text {
                x: Tok.card-padding; y: 132px;
                width: parent.width - Tok.card-padding * 2; height: 36px;
                text: root.preview-note; color: root.configuration-error ? Tok.error : Tok.muted;
                font-size: Tok.caption-size; wrap: word-wrap;
                accessible-label: root.preview-note;
            }
            Rectangle { x: Tok.card-padding; y: 180px; width: parent.width - Tok.card-padding * 2; height: Tok.border-width; background: Tok.row-line; }
            // Match the real dependency order: flow, then version, then trace.
            HorizontalLayout {
                x: Tok.card-padding; y: 200px; width: parent.width - Tok.card-padding * 2; spacing: Tok.field-gap;
                Text { text: "Flusso"; color: Tok.ink; font-weight: Tok.semibold-weight; }
                Text { text: "Versione schema"; color: Tok.ink; font-weight: Tok.semibold-weight; }
                Text { text: "Tracciato"; color: Tok.ink; font-weight: Tok.semibold-weight; }
            }
            HorizontalLayout {
                x: Tok.card-padding; y: 224px; width: parent.width - Tok.card-padding * 2; spacing: Tok.field-gap;
                ChoiceBox { options: root.flows; current-index <=> root.flow-index; placeholder: "Scegli flusso"; enabled: root.bundle-ready && !root.busy; selected(index) => { root.choose-flow(index); } }
                ChoiceBox { options: root.versions; current-index <=> root.version-index; placeholder: "Scegli versione"; enabled: root.flow-index >= 0 && !root.busy; selected(index) => { root.choose-version(index); } }
                ChoiceBox { options: root.traces; current-index <=> root.trace-index; placeholder: "Scegli tracciato"; enabled: root.version-index >= 0 && !root.busy; selected(index) => { root.choose-trace(index); } }
            }
            Text {
                x: Tok.card-padding; y: 272px; width: parent.width - Tok.card-padding * 2;
                text: "Controlli locali sul tracciato selezionato. La versione va scelta esplicitamente.";
                color: Tok.muted; font-size: Tok.caption-size; wrap: word-wrap;
            }
            Text { x: Tok.card-padding; y: 318px; text: "Encoding del file"; color: Tok.ink; font-weight: Tok.semibold-weight; }
            ChoiceBox {
                x: Tok.card-padding; y: 342px; width: parent.width - Tok.card-padding * 2;
                options: ["UTF-8"]; current-index <=> root.encoding-index; placeholder: "Scegli encoding"; enabled: !root.busy;
                selected(index) => { root.choose-encoding(index); }
            }
            Rectangle { x: Tok.card-padding; y: 402px; width: parent.width - Tok.card-padding * 2; height: Tok.border-width; background: Tok.row-line; }
            Text { x: Tok.card-padding; y: 418px; text: "Formati del report"; color: Tok.ink; font-weight: Tok.semibold-weight; }
            HorizontalLayout {
                x: Tok.card-padding; y: 440px; width: Tok.reports-width; height: Tok.control-height; spacing: Tok.control-gap;
                ReportCheck { label: "XLSX"; checked <=> root.report-xlsx; enabled: !root.busy; toggled(value) => { root.reports-changed(); } }
                ReportCheck { label: "JSONL"; checked <=> root.report-jsonl; enabled: !root.busy; toggled(value) => { root.reports-changed(); } }
                ReportCheck { label: "CSV"; checked <=> root.report-csv; enabled: !root.busy; toggled(value) => { root.reports-changed(); } }
            }
        }
        run := Rectangle {
            x: root.narrow ? Tok.page-padding : Tok.page-padding + config.width + Tok.panel-gap;
            y: root.narrow ? config.y + config.height + Tok.panel-gap : config.y;
            width: root.narrow ? root.content-width : root.content-width - config.width - Tok.panel-gap;
            height: config.height;
            background: Tok.surface; border-width: Tok.border-width;
            border-color: Tok.border; border-radius: Tok.card-radius;
            Rectangle { x: Tok.border-width; y: Tok.border-width; width: parent.width - Tok.border-width * 2; height: 4px; background: root.configuration-error || root.validation-invalid ? Tok.error : root.execution-partial ? Tok.warn : Tok.accent; }
            ScrollView {
                x: 0px; y: 4px; width: parent.width; height: parent.height - 104px;
                content-width: self.visible-width;
                VerticalLayout {
                width: parent.width; padding: Tok.card-padding; spacing: Tok.field-gap; alignment: start;
                Text { text: "Esecuzione"; color: Tok.ink; font-size: Tok.section-size; font-weight: Tok.semibold-weight; }
                Text {
                    text: root.execution-label; color: root.configuration-error || root.validation-invalid ? Tok.error : root.execution-partial ? Tok.warn : Tok.ink;
                    font-size: 24px; font-weight: Tok.semibold-weight; wrap: word-wrap;
                }
                Text { text: root.status-note; color: root.configuration-error || root.validation-invalid ? Tok.error : root.execution-partial ? Tok.warn : Tok.muted; wrap: word-wrap; }
                Rectangle { height: Tok.border-width; background: Tok.row-line; }
                Text { text: "Schema selezionato"; color: Tok.muted; font-size: Tok.caption-size; }
                Text { text: root.schema-label; color: Tok.ink; font-family: Tok.mono; font-size: Tok.caption-size; wrap: word-wrap; }
                Text { text: root.origin-label; color: Tok.muted; font-size: Tok.caption-size; wrap: word-wrap; }
                Text {
                    text: root.execution-detail != "" ? root.execution-detail : root.worker-available ? "Completa la configurazione, poi avvia l’analisi." : "L’avvio dell’analisi non è disponibile in questa build.";
                    color: Tok.muted; wrap: word-wrap;
                }
            }
            }
            Rectangle {
                x: Tok.card-padding; y: parent.height - 92px;
                width: parent.width - Tok.card-padding * 2; height: Tok.border-width; background: Tok.row-line;
            }
            ActionButton {
                x: Tok.card-padding; y: parent.height - Tok.card-padding - Tok.control-height;
                width: parent.width - Tok.card-padding * 2;
                primary: !root.busy; danger: root.busy;
                label: root.busy ? "Annulla analisi" : "Avvia analisi";
                enabled: root.busy || (root.ready && root.worker-available);
                activated => { if (root.busy) { root.cancel-analysis(); } else { root.start-analysis(); } }
            }
        }
    }
}

export component FileBrowser inherits Rectangle {
    in-out property <string> directory;
    in property <[BrowserItem]> entries;
    in property <string> error-note;
    in-out property <int> current-index: -1;
    callback open-directory(string);
    callback activate(int);
    callback parent-directory();
    callback cancel();
    background: Tok.bg;
    changed current-index => {
        if (root.current-index >= 0) {
            if (root.current-index * Tok.item-height + files.content-y < 0px) { files.content-y = -root.current-index * Tok.item-height; }
            if ((root.current-index + 1) * Tok.item-height + files.content-y > files.height) { files.content-y = files.height - (root.current-index + 1) * Tok.item-height; }
        }
    }
    VerticalLayout {
        padding: Tok.page-padding; spacing: Tok.control-gap;
        Text { text: "Seleziona il file di input"; color: Tok.ink; font-size: Tok.title-size; font-weight: Tok.bold-weight; }
        HorizontalLayout {
            height: Tok.control-height; spacing: Tok.picker-gap;
            FieldEdit { text <=> root.directory; placeholder: "Cartella"; monospace: true; confirmed(value) => { root.open-directory(value); } }
            ActionButton { width: Tok.secondary-action-width; label: "Apri cartella"; activated => { root.open-directory(root.directory); } }
            ActionButton { width: Tok.secondary-action-width; label: "Cartella padre"; activated => { root.parent-directory(); } }
        }
        Text { text: root.error-note; color: Tok.error; height: Tok.control-height; }
        Rectangle {
            background: Tok.surface; border-width: key.has-focus ? Tok.focus-width : Tok.border-width; border-color: key.has-focus ? Tok.accent : Tok.border;
            files := Flickable {
                content-height: root.entries.length * Tok.item-height;
                content-width: self.width;
                for entry[index] in root.entries: Rectangle {
                    y: index * Tok.item-height;
                    width: files.width;
                    height: Tok.item-height;
                    background: root.current-index == index ? Tok.accent-tint : row-touch.has-hover ? Tok.header-bg : Tok.surface;
                    Text { x: Tok.field-padding; width: parent.width - Tok.secondary-action-width; height: parent.height; text: entry.label; color: entry.selectable ? Tok.ink : Tok.disabled-ink; font-family: Tok.mono; vertical-alignment: center; overflow: elide; }
                    Text { x: parent.width - Tok.browser-type-column; width: Tok.browser-type-width; height: parent.height; text: !entry.selectable ? "Non disponibile" : entry.directory ? "Cartella" : "File"; color: Tok.muted; font-size: Tok.caption-size; vertical-alignment: center; }
                    row-touch := TouchArea { enabled: entry.selectable; clicked => { key.focus(); root.current-index = index; } }
                }
            }
            key := FocusScope {
                width: 0px;
                key-pressed(event) => {
                    if (event.text == Key.DownArrow && root.entries.length > 0) { root.current-index = min(root.entries.length - 1, root.current-index + 1); return accept; }
                    if (event.text == Key.UpArrow && root.entries.length > 0) { root.current-index = max(0, root.current-index - 1); return accept; }
                    if (event.text == Key.Return && root.current-index >= 0) { root.activate(root.current-index); return accept; }
                    if (event.text == Key.Escape) { root.cancel(); return accept; }
                    return reject;
                }
            }
        }
        HorizontalLayout {
            height: Tok.control-height; spacing: Tok.control-gap;
            Rectangle { horizontal-stretch: 1; }
            ActionButton { width: Tok.secondary-action-width; label: "Annulla"; activated => { root.cancel(); } }
            ActionButton { width: Tok.primary-action-width; label: "Apri selezione"; primary: true; enabled: root.current-index >= 0 && root.current-index < root.entries.length && root.entries[root.current-index].selectable; activated => { root.activate(root.current-index); } }
        }
    }
}
