import { Tok } from "tokens.slint";
import { AboutSlint, Palette } from "std-widgets.slint";
import { AnalysisForm, FileBrowser, BrowserItem } from "analysis.slint";
export { Tok, BrowserItem }

import { ActionButton, ThemeChoice } from "controls.slint";

export component MainWindow inherits Window {
    in-out property <bool> dark-mode <=> Tok.dark-mode;
    in-out property <bool> show-info: false;
    in property <string> version;
    in property <[string]> flows;
    in property <[string]> versions;
    in property <[string]> traces;
    in-out property <int> flow-index: -1;
    in-out property <int> version-index: -1;
    in-out property <int> trace-index: -1;
    in-out property <int> encoding-index: -1;
    in-out property <string> file-path;
    in-out property <bool> report-jsonl: true;
    in-out property <bool> report-xlsx: true;
    in-out property <bool> report-csv: false;
    in property <string> preview-note: "Seleziona un file per il controllo preliminare.";
    in property <string> status-note: "Scegli file, flusso, versione, tracciato ed encoding.";
    in property <string> origin-label: "Dati non disponibili";
    in property <string> schema-label: "Nessuno schema selezionato";
    in property <bool> configuration-error: false;
    in property <bool> bundle-ready: false;
    in property <bool> analysis-ready: false;
    in property <string> execution-label: "Analisi non avviata";
    in property <string> execution-detail;
    in property <bool> validation-invalid: false;
    in property <bool> execution-partial: false;
    in property <bool> busy: false;
    in property <bool> worker-available: false;
    in-out property <bool> browser-open: false;
    in-out property <string> browser-directory;
    in property <[BrowserItem]> browser-entries;
    in property <string> browser-error;
    in-out property <int> browser-index: -1;
    callback file-edited(string);
    callback file-confirmed(string);
    callback browse();
    callback choose-flow(int);
    callback choose-version(int);
    callback choose-trace(int);
    callback choose-encoding(int);
    callback reports-changed();
    callback start-analysis();
    callback cancel-analysis();
    callback worker-poll();
    callback browser-directory-chosen(string);
    callback browser-activate(int);
    callback browser-parent();
    callback browser-cancel();
    title: "Lintra";
    preferred-width: Tok.canvas-width;
    preferred-height: Tok.analysis-height;
    min-width: Tok.min-width;
    min-height: Tok.min-height;
    background: Tok.bg;
    default-font-family: Tok.sans;
    default-font-size: Tok.body-size;
    init => { Palette.color-scheme = ColorScheme.light; }
    changed dark-mode => {
        Palette.color-scheme = root.dark-mode ? ColorScheme.dark : ColorScheme.light;
    }

    VerticalLayout {
        padding: 0px;
        spacing: 0px;
        Rectangle {
            height: Tok.header-height;
            background: Tok.nav-bg;
            HorizontalLayout {
                y: (parent.height - self.height) / 2;
                height: Tok.control-height;
                width: parent.width;
                padding-left: Tok.page-padding;
                padding-right: Tok.page-padding;
                spacing: Tok.control-gap;
                Text {
                    text: "Lintra";
                    color: Tok.nav-ink;
                    font-size: Tok.brand-size;
                    font-weight: Tok.bold-weight;
                    vertical-alignment: center;
                    horizontal-stretch: 0;
                }
                if root.width >= Tok.header-breakpoint: Text {
                    text: "Validatore di flussi regionali";
                    color: Tok.nav-muted; vertical-alignment: center;
                }
                Rectangle { horizontal-stretch: 1; }
                if root.width >= Tok.header-breakpoint: Text {
                    text: root.origin-label;
                    width: Tok.origin-width;
                    font-family: Tok.mono; font-size: Tok.caption-size;
                    color: Tok.nav-muted; overflow: elide; vertical-alignment: center;
                    accessible-label: root.origin-label;
                }
                Text {
                    text: "Tema";
                    color: Tok.nav-muted;
                    vertical-alignment: center;
                    horizontal-stretch: 0;
                }
                light := ThemeChoice {
                    width: Tok.choice-width;
                    label: "Chiaro";
                    selected: !root.dark-mode;
                    activated => { root.dark-mode = false; }
                }
                dark := ThemeChoice {
                    width: Tok.choice-width;
                    label: "Scuro";
                    selected: root.dark-mode;
                    activated => { root.dark-mode = true; }
                }
                ActionButton {
                    width: Tok.info-width;
                    label: "Informazioni";
                    selected: root.show-info;
                    activated => { root.show-info = !root.show-info; }
                }
            }
        }
        Rectangle {
            vertical-stretch: 1;
            background: Tok.bg;
            if !root.show-info && !root.browser-open: AnalysisForm {
                flows: root.flows; versions: root.versions; traces: root.traces;
                flow-index <=> root.flow-index; version-index <=> root.version-index;
                trace-index <=> root.trace-index; encoding-index <=> root.encoding-index;
                file-path <=> root.file-path;
                report-jsonl <=> root.report-jsonl; report-xlsx <=> root.report-xlsx;
                report-csv <=> root.report-csv;
                preview-note: root.preview-note; status-note: root.status-note;
                origin-label: root.origin-label; configuration-error: root.configuration-error;
                bundle-ready: root.bundle-ready; ready: root.analysis-ready;
                busy: root.busy; worker-available: root.worker-available;
                execution-label: root.execution-label; execution-detail: root.execution-detail;
                validation-invalid: root.validation-invalid; execution-partial: root.execution-partial;
                file-edited(value) => { root.file-edited(value); }
                file-confirmed(value) => { root.file-confirmed(value); }
                browse => { root.browse(); }
                choose-flow(index) => { root.choose-flow(index); }
                choose-version(index) => { root.choose-version(index); }
                choose-trace(index) => { root.choose-trace(index); }
                choose-encoding(index) => { root.choose-encoding(index); }
                reports-changed => { root.reports-changed(); }
                start-analysis => { root.start-analysis(); }
                cancel-analysis => { root.cancel-analysis(); }
            }
            if !root.show-info && root.browser-open: FileBrowser {
                directory <=> root.browser-directory;
                entries: root.browser-entries; current-index <=> root.browser-index;
                error-note: root.browser-error;
                open-directory(path) => { root.browser-directory-chosen(path); }
                activate(index) => { root.browser-activate(index); }
                parent-directory => { root.browser-parent(); }
                cancel => { root.browser-cancel(); }
            }
            if root.show-info: Rectangle {
                x: (parent.width - self.width) / 2;
                y: Tok.page-padding;
                width: Tok.about-width;
                height: Tok.about-height;
                background: Tok.surface;
                border-color: Tok.border;
                border-width: Tok.border-width;
                border-radius: Tok.control-radius;
                VerticalLayout {
                    padding: Tok.page-padding;
                    Text { text: "Lintra " + root.version; color: Tok.ink; font-weight: Tok.semibold-weight; }
                    Text { text: root.schema-label; color: Tok.muted; font-size: Tok.caption-size; wrap: word-wrap; }
                    Text { text: root.origin-label; color: Tok.muted; font-size: Tok.caption-size; wrap: word-wrap; }
                    // Actual licensed widget, reachable from the top-level control.
                    AboutSlint { }
                }
            }
        }
        Rectangle {
            height: Tok.footer-height;
            background: Tok.bg;
            Text {
                x: Tok.page-padding;
                width: parent.width - Tok.page-padding * 2;
                height: parent.height;
                text: "Lintra " + root.version;
                color: Tok.muted;
                font-size: Tok.caption-size;
                vertical-alignment: center;
            }
        }
    }
}
