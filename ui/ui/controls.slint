import { Tok } from "tokens.slint";
// Shared native controls implement Copper Ledger. Focus, pointer and
// accessibility activation all invoke the same action; no decorative toggles.
export component ActionButton inherits Rectangle {
    in property <string> label;
    in property <bool> selected: false;
    in property <bool> danger: false;
    in property <bool> primary: false;
    in property <bool> navigation: false;
    in property <bool> enabled: true;
    callback activated();
    height: Tok.control-height;
    background: root.navigation ? (root.selected || button-touch.has-hover ? Tok.nav-selected : Tok.nav-bg) : !root.enabled ? Tok.disabled-bg : root.primary ? (button-touch.has-hover ? Tok.accent-hover : Tok.accent) : root.selected ? Tok.accent-tint : button-touch.has-hover ? Tok.header-bg : Tok.surface;
    border-radius: Tok.control-radius;
    border-width: key.has-focus ? Tok.focus-width : Tok.border-width;
    border-color: root.navigation ? (key.has-focus ? Tok.nav-focus : Tok.nav-bg) : root.danger ? Tok.error : key.has-focus || root.selected || root.primary ? Tok.accent : Tok.border;
    accessible-role: button;
    accessible-label: root.label;
    accessible-enabled: root.enabled;
    accessible-action-default => { if (root.enabled) { root.activated(); } }
    forward-focus: key;
    Text {
        text: root.label;
        overflow: elide;
        color: root.navigation ? (!root.enabled ? Tok.nav-muted : Tok.nav-ink) : !root.enabled ? Tok.disabled-ink : root.danger ? Tok.error : root.primary ? Tok.on-accent : root.selected ? Tok.accent : Tok.ink;
        font-family: Tok.sans;
        font-size: Tok.body-size;
        font-weight: Tok.semibold-weight;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    button-touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        width: parent.width;
        height: parent.height;
        clicked => { key.focus(); root.activated(); }
    }
    key := FocusScope {
        width: 0px;
        enabled: root.enabled;
        key-pressed(event) => {
            if (event.text == Key.Space || event.text == Key.Return) {
                root.activated();
                return accept;
            }
            return reject;
        }
    }
}

export component ThemeChoice inherits ActionButton {
    accessible-role: radio-button;
    accessible-checked: root.selected;
}


export component FieldEdit inherits Rectangle {
    in-out property <string> text;
    in property <string> placeholder;
    in property <bool> enabled: true;
    in property <bool> monospace: false;
    callback edited(string);
    callback confirmed(string);
    height: Tok.control-height;
    background: root.enabled ? Tok.surface : Tok.disabled-bg;
    border-color: editor.has-focus ? Tok.accent : Tok.border;
    border-width: editor.has-focus ? Tok.focus-width : Tok.border-width;
    border-radius: Tok.control-radius;
    forward-focus: editor;
    accessible-role: text-input;
    accessible-label: root.placeholder;
    accessible-value: root.text;
    accessible-enabled: root.enabled;
    accessible-action-set-value(value) => { if (root.enabled) { root.text = value; root.edited(value); } }
    Text {
        x: Tok.field-padding;
        width: parent.width - Tok.field-padding * 2;
        height: parent.height;
        text: root.text == "" ? root.placeholder : "";
        overflow: elide;
        color: root.enabled ? Tok.muted : Tok.disabled-ink;
        font-size: Tok.body-size;
        font-family: root.monospace ? Tok.mono : Tok.sans;
        vertical-alignment: center;
    }
    editor := TextInput {
        x: Tok.field-padding;
        width: parent.width - Tok.field-padding * 2;
        height: parent.height;
        text <=> root.text;
        enabled: root.enabled;
        single-line: true;
        color: root.enabled ? Tok.ink : Tok.disabled-ink;
        font-family: root.monospace ? Tok.mono : Tok.sans;
        font-size: Tok.body-size;
        vertical-alignment: center;
        selection-background-color: Tok.accent-tint;
        selection-foreground-color: Tok.ink;
        edited => { root.edited(self.text); }
        accepted => { root.confirmed(self.text); }
    }
}

export component ChoiceBox inherits Rectangle {
    in property <[string]> options;
    in-out property <int> current-index: -1;
    in property <string> placeholder;
    in property <bool> enabled: true;
    callback selected(int);
    property <int> hover-index: 0;
    height: Tok.control-height;
    background: root.enabled ? Tok.surface : Tok.disabled-bg;
    border-color: key.has-focus ? Tok.accent : Tok.border;
    border-width: key.has-focus ? Tok.focus-width : Tok.border-width;
    border-radius: Tok.control-radius;
    accessible-action-default => {
        if (root.enabled && root.options.length > 0) {
            key.focus(); root.hover-index = max(0, root.current-index); popup.show();
        }
    }
    accessible-role: combobox;
    accessible-label: root.placeholder;
    accessible-value: label.text;
    accessible-enabled: root.enabled;
    forward-focus: key;
    label := Text {
        x: Tok.field-padding;
        width: parent.width - Tok.field-padding * 3 - Tok.icon-width;
        height: parent.height;
        text: root.current-index >= 0 && root.current-index < root.options.length ? root.options[root.current-index] : root.placeholder;
        color: !root.enabled ? Tok.disabled-ink : root.current-index >= 0 ? Tok.ink : Tok.muted;
        font-size: Tok.body-size;
        vertical-alignment: center;
        overflow: elide;
    }
    Path {
        x: parent.width - Tok.field-padding - Tok.icon-width;
        y: (parent.height - Tok.icon-height) / 2;
        width: Tok.icon-width;
        height: Tok.icon-height;
        viewbox-width: 12;
        viewbox-height: 8;
        commands: "M 1 1 L 6 6 L 11 1";
        stroke: Tok.muted;
        stroke-width: Tok.icon-stroke;
    }
    TouchArea {
        enabled: root.enabled && root.options.length > 0;
        clicked => { key.focus(); root.hover-index = max(0, root.current-index); popup.show(); }
    }
    key := FocusScope {
        width: 0px;
        enabled: root.enabled;
        key-pressed(event) => {
            if (event.text == Key.DownArrow && root.options.length > 0) {
                root.current-index = min(root.options.length - 1, root.current-index + 1);
                root.selected(root.current-index); return accept;
            }
            if (event.text == Key.UpArrow && root.options.length > 0) {
                root.current-index = max(0, root.current-index - 1);
                root.selected(root.current-index); return accept;
            }
            if ((event.text == Key.Space || event.text == Key.Return) && root.options.length > 0) {
                root.hover-index = max(0, root.current-index); popup.show(); return accept;
            }
            return reject;
        }
    }
    popup := PopupWindow {
        x: 0px;
        y: root.height;
        width: root.width;
        height: min(Tok.popup-max-height, root.options.length * Tok.item-height);
        close-policy: close-on-click-outside;
        forward-focus: popup-key;
        Rectangle {
            background: Tok.surface;
            border-color: Tok.border;
            border-width: Tok.border-width;
            Flickable {
                // Keep keyboard-highlighted options visible in long catalogs.
                content-y: -max(0px, (root.hover-index + 1) * Tok.item-height - self.height);
                content-height: root.options.length * Tok.item-height;
                content-width: root.width;
                for value[index] in root.options: Rectangle {
                    y: index * Tok.item-height;
                    width: root.width;
                    height: Tok.item-height;
                    background: index == root.hover-index || item-touch.has-hover ? Tok.accent-tint : Tok.surface;
                    Text {
                        x: Tok.field-padding;
                        width: parent.width - Tok.field-padding * 2;
                        height: parent.height;
                        text: value;
                        color: index == root.hover-index ? Tok.accent : Tok.ink;
                        vertical-alignment: center;
                        overflow: elide;
                    }
                    item-touch := TouchArea {
                        clicked => { root.current-index = index; root.selected(index); popup.close(); }
                    }
                }
            }
        }
        popup-key := FocusScope {
            width: 0px;
            key-pressed(event) => {
                if (event.text == Key.Escape) { popup.close(); return accept; }
                if (event.text == Key.DownArrow) { root.hover-index = min(root.options.length - 1, root.hover-index + 1); return accept; }
                if (event.text == Key.UpArrow) { root.hover-index = max(0, root.hover-index - 1); return accept; }
                if (event.text == Key.Return || event.text == Key.Space) {
                    root.current-index = root.hover-index; root.selected(root.hover-index); popup.close(); return accept;
                }
                return reject;
            }
        }
    }
}

export component ReportCheck inherits Rectangle {
    // Focus must remain visible independently from the checkbox's value.
    border-width: key.has-focus ? Tok.focus-width : 0px;
    border-color: Tok.accent;
    border-radius: Tok.control-radius;
    in property <string> label;
    in-out property <bool> checked;
    in property <bool> enabled: true;
    callback toggled(bool);
    accessible-action-default => {
        if (root.enabled) { root.checked = !root.checked; root.toggled(root.checked); }
    }
    accessible-role: checkbox;
    accessible-label: root.label;
    accessible-checked: root.checked;
    accessible-enabled: root.enabled;
    forward-focus: key;
    height: Tok.control-height;
    Rectangle {
        x: 0px;
        y: (parent.height - Tok.body-size) / 2;
        width: Tok.body-size;
        height: Tok.body-size;
        border-width: Tok.border-width;
        border-color: root.checked ? Tok.accent : Tok.border;
        border-radius: Tok.border-width;
        background: root.checked ? Tok.accent : Tok.surface;
        if root.checked: Path {
            width: parent.width;
            height: parent.height;
            viewbox-width: 14;
            viewbox-height: 14;
            commands: "M 3 7 L 6 10 L 11 4";
            stroke: Tok.on-accent;
            stroke-width: Tok.icon-stroke;
        }
    }
    Text {
        x: Tok.body-size + Tok.picker-gap;
        width: parent.width - self.x;
        height: parent.height;
        text: root.label;
        color: root.enabled ? Tok.ink : Tok.disabled-ink;
        vertical-alignment: center;
    }
    TouchArea {
        enabled: root.enabled;
        clicked => { key.focus(); root.checked = !root.checked; root.toggled(root.checked); }
    }
    key := FocusScope {
        width: 0px;
        enabled: root.enabled;
        key-pressed(event) => {
            if (event.text == Key.Space || event.text == Key.Return) {
                root.checked = !root.checked; root.toggled(root.checked); return accept;
            }
            return reject;
        }
    }
}
