import { ListView, ScrollView } from "std-widgets.slint";
import { Tok } from "tokens.slint";
import { ActionButton, FieldEdit } from "controls.slint";

export struct ErrorRow {
    trace: string, line: string, record: string, field: string, field-name: string,
    code: string, position: string, actual: string, expected: string,
    context: string, message: string,
}
component DetailValue inherits VerticalLayout {
    in property <string> label;
    in property <string> value;
    spacing: Tok.detail-meta-spacing;
    alignment: start;
    vertical-stretch: 0;
    Text { text: root.label; color: Tok.muted; font-size: Tok.caption-size; }
    Text { text: root.value; color: Tok.ink; font-family: Tok.mono; font-size: Tok.caption-size; wrap: word-wrap; }
}
export component ResultsView inherits Rectangle {
    in property <[ErrorRow]> rows;
    in property <ErrorRow> detail;
    in property <string> domain-text;
    in property <bool> domain-more;
    callback next-domain-page();
    callback restart-domain();
    in property <int> selected: -1;
    in property <string> heading;
    in property <string> summary;
    in property <string> scope;
    in property <string> note;
    in property <bool> loading;
    in property <bool> error;
    in property <bool> invalid;
    in-out property <string> filter-code;
    in-out property <string> filter-field;
    in-out property <string> filter-record;
    in-out property <string> filter-fiscal;
    in-out property <string> filter-line;
    in-out property <length> scroll-y;
    callback apply-filter();
    callback select-row(int);
    callback new-analysis();
    callback export-report();
    background: Tok.bg;
    property <bool> narrow: root.width < Tok.form-breakpoint;
    function move-selection(index: int) {
        if root.rows.length > 0 && !root.loading {
            root.select-row(max(0, min(root.rows.length - 1, index)));
        }
    }
    changed selected => {
        if root.selected >= 0 {
            if root.selected * Tok.result-row-height < -list.content-y {
                list.content-y = -root.selected * Tok.result-row-height;
            } else if (root.selected + 1) * Tok.result-row-height > -list.content-y + list.visible-height {
                list.content-y = list.visible-height - (root.selected + 1) * Tok.result-row-height;
            }
        }
    }
    // The workspace grows with the window. Each pane scrolls independently;
    // small windows stack panes while retaining full-width technical columns.
    property <length> workspace-height: max(Tok.inspector-min-height, root.height - introduction.height - Tok.page-padding * 2 - 60px);
    ScrollView {
        width: parent.width; height: parent.height;
        content-width: self.visible-width;
        VerticalLayout {
            width: parent.width; padding: Tok.page-padding; spacing: Tok.result-panel-gap;
            introduction := Rectangle {
                height: max(Tok.results-title-height, scope-line.y + scope-line.preferred-height);
                Text {
                    x: 0px; y: 0px;
                    width: parent.width - Tok.primary-action-width - Tok.control-gap; height: root.narrow ? 72px : 38px;
                    text: root.heading; color: root.invalid ? Tok.error : Tok.ink;
                    font-size: Tok.title-size; font-weight: Tok.semibold-weight;
                    wrap: word-wrap; accessible-label: root.heading;
                }
                summary-line := Text {
                    x: 0px; y: root.narrow ? 80px : 46px; width: parent.width; text: root.summary;
                    color: Tok.ink; font-size: Tok.body-size; wrap: word-wrap;
                }
                scope-line := Text {
                    x: 0px; y: max(76px, summary-line.y + summary-line.preferred-height + Tok.picker-gap); width: parent.width;
                    text: root.scope; color: Tok.muted;
                    font-family: Tok.mono; font-size: Tok.caption-size; overflow: elide;
                    accessible-label: root.scope;
                }
                ActionButton {
                    x: parent.width - Tok.primary-action-width; y: 0px;
                    width: Tok.primary-action-width; primary: true; label: "Esporta report";
                    activated => { root.export-report(); }
                }
            }
            Rectangle {
                height: root.narrow ? table.height + Tok.panel-gap + details.height : root.workspace-height;
                background: Tok.bg;
                table := Rectangle {
                    x: 0px; y: 0px;
                    width: root.narrow ? parent.width : parent.width - Tok.detail-width - Tok.result-panel-gap;
                    height: root.workspace-height;
                    background: Tok.surface;
                    border-width: table-key.has-focus ? Tok.focus-width : Tok.border-width;
                    border-color: table-key.has-focus ? Tok.accent : Tok.border;
                    border-radius: Tok.card-radius;
                    ScrollView {
                        x: Tok.border-width; y: Tok.border-width;
                        width: parent.width - Tok.border-width * 2; height: parent.height - Tok.border-width * 2;
                        content-width: max(self.visible-width, Tok.table-min-width);
                        content-height: self.visible-height;
                        VerticalLayout {
                            x: 0px; y: 0px; width: parent.width; height: parent.height;
                            padding: Tok.result-padding; spacing: Tok.control-gap;
                            HorizontalLayout {
                                height: 24px;
                                Text { text: "Diagnostiche"; color: Tok.ink; font-size: Tok.section-size; font-weight: Tok.semibold-weight; }
                                Text { text: root.rows.length + (root.rows.length == 1 ? " diagnostica trovata" : " diagnostiche trovate"); color: Tok.muted; font-family: Tok.mono; font-size: Tok.caption-size; horizontal-alignment: right; vertical-alignment: center; }
                            }
                            HorizontalLayout {
                                height: 60px; spacing: Tok.picker-gap;
                                VerticalLayout {
                                    spacing: Tok.space-small;
                                    Text { text: "Codice"; color: Tok.muted; font-size: Tok.caption-size; }
                                    FieldEdit { text <=> root.filter-code; placeholder: "Codice"; monospace: true; enabled: !root.loading; confirmed(_) => { root.apply-filter(); } }
                                }
                                VerticalLayout {
                                    spacing: Tok.space-small;
                                    Text { text: "ID campo"; color: Tok.muted; font-size: Tok.caption-size; }
                                    FieldEdit { text <=> root.filter-field; placeholder: "ID campo"; enabled: !root.loading; confirmed(_) => { root.apply-filter(); } }
                                }
                                VerticalLayout {
                                    spacing: Tok.space-small;
                                    Text { text: "ID record"; color: Tok.muted; font-size: Tok.caption-size; }
                                    FieldEdit { text <=> root.filter-record; placeholder: "ID record"; enabled: !root.loading; confirmed(_) => { root.apply-filter(); } }
                                }
                                VerticalLayout {
                                    spacing: Tok.space-small;
                                    Text { text: "Codice fiscale"; color: Tok.muted; font-size: Tok.caption-size; }
                                    FieldEdit { text <=> root.filter-fiscal; placeholder: "Codice fiscale"; enabled: !root.loading; confirmed(_) => { root.apply-filter(); } }
                                }
                                VerticalLayout {
                                    spacing: Tok.space-small;
                                    Text { text: "Riga"; color: Tok.muted; font-size: Tok.caption-size; }
                                    FieldEdit { text <=> root.filter-line; placeholder: "Riga"; enabled: !root.loading; confirmed(_) => { root.apply-filter(); } }
                                }
                            }
                            Rectangle {
                                vertical-stretch: 1;
                                VerticalLayout {
                                    spacing: 0px;
                                    Rectangle {
                                        height: Tok.result-row-height; background: Tok.header-bg;
                                        HorizontalLayout {
                                            padding-left: Tok.picker-gap; padding-right: Tok.picker-gap; spacing: Tok.picker-gap;
                                            Text { width: Tok.result-line-width; text: "Riga"; color: Tok.muted; font-size: Tok.caption-size; vertical-alignment: center; horizontal-alignment: right; }
                                            Text { width: Tok.result-record-width; text: "ID record"; color: Tok.muted; font-size: Tok.caption-size; vertical-alignment: center; }
                                            Text { width: Tok.result-field-width; text: "Campo"; color: Tok.muted; font-size: Tok.caption-size; vertical-alignment: center; }
                                            Text { width: Tok.result-code-width; text: "Codice"; color: Tok.muted; font-size: Tok.caption-size; vertical-alignment: center; }
                                            Text { text: "Messaggio"; color: Tok.muted; font-size: Tok.caption-size; vertical-alignment: center; }
                                        }
                                    }
                                    list := ListView {
                                        content-y <=> root.scroll-y;
                                        min-height: Tok.result-empty-height;
                                        vertical-stretch: 1;
                                        for row[index] in root.rows: Rectangle {
                                            height: Tok.result-row-height;
                                            background: index == root.selected ? Tok.accent-tint : touch.has-hover ? Tok.header-bg : Tok.surface;
                                            accessible-role: list-item;
                                            accessible-label: "Riga " + row.line + ", campo " + row.field + ", " + row.code + ": " + row.message;
                                            accessible-action-default => { root.select-row(index); }
                                            Rectangle { x: 0px; y: 0px; width: 1px; height: parent.height; background: index == root.selected ? Tok.accent : transparent; }
                                            Rectangle { y: parent.height - Tok.border-width; height: Tok.border-width; background: Tok.row-line; }
                                            HorizontalLayout {
                                                padding-left: Tok.picker-gap; padding-right: Tok.picker-gap; spacing: Tok.picker-gap;
                                                Text { width: Tok.result-line-width; text: row.line; color: Tok.ink; font-family: Tok.mono; font-size: Tok.caption-size; vertical-alignment: center; horizontal-alignment: right; overflow: elide; }
                                                Text { width: Tok.result-record-width; text: row.record; color: Tok.ink; font-family: Tok.mono; font-size: Tok.caption-size; vertical-alignment: center; overflow: elide; }
                                                Text { width: Tok.result-field-width; text: row.field; color: Tok.ink; font-family: Tok.mono; font-size: Tok.caption-size; vertical-alignment: center; overflow: elide; }
                                                Text { width: Tok.result-code-width; text: row.code; color: Tok.error; font-family: Tok.mono; font-size: Tok.caption-size; vertical-alignment: center; overflow: elide; }
                                                Text { text: row.message; color: Tok.ink; font-size: Tok.caption-size; vertical-alignment: center; overflow: elide; }
                                            }
                                            touch := TouchArea { enabled: !root.loading; mouse-cursor: pointer; clicked => { table-key.focus(); root.select-row(index); } }
                                        }
                                    }
                                }
                                if root.rows.length == 0: VerticalLayout {
                                    padding: Tok.page-padding; spacing: Tok.picker-gap; alignment: center;
                                    Text { text: root.loading ? "Lettura delle diagnostiche…" : "Nessuna diagnostica visibile"; color: Tok.ink; font-weight: Tok.semibold-weight; }
                                    Text { text: root.loading ? "Il report viene letto dal disco." : "Consulta il riepilogo dell’analisi o modifica i filtri."; color: Tok.muted; wrap: word-wrap; }
                                }
                            }
                            HorizontalLayout {
                                height: Tok.control-height; spacing: Tok.control-gap;
                                Text { text: root.loading ? "Lettura in corso…" : "Corrispondenza esatta · Invio per applicare"; color: Tok.muted; font-size: Tok.caption-size; vertical-alignment: center; overflow: elide; }
                                ActionButton { width: Tok.primary-action-width; label: "Applica filtri"; enabled: !root.loading; activated => { root.apply-filter(); } }
                            }
                        }
                    }
                    table-key := FocusScope {
                        width: 0px; enabled: !root.loading;
                        key-pressed(event) => {
                            if event.text == Key.DownArrow { root.move-selection(root.selected + 1); return accept; }
                            if event.text == Key.UpArrow { root.move-selection(root.selected - 1); return accept; }
                            if event.text == Key.Home { root.move-selection(0); return accept; }
                            if event.text == Key.End { root.move-selection(root.rows.length - 1); return accept; }
                            if event.text == Key.PageDown { root.move-selection(root.selected + max(1, floor(list.visible-height / Tok.result-row-height))); return accept; }
                            if event.text == Key.PageUp { root.move-selection(root.selected - max(1, floor(list.visible-height / Tok.result-row-height))); return accept; }
                            return reject;
                        }
                    }
                }
                details := Rectangle {
                    x: root.narrow ? 0px : table.width + Tok.result-panel-gap;
                    y: root.narrow ? table.height + Tok.panel-gap : 0px;
                    width: root.narrow ? parent.width : Tok.detail-width;
                    height: root.workspace-height;
                    background: Tok.surface; border-width: Tok.border-width;
                    border-color: Tok.border; border-radius: Tok.card-radius;
                    ScrollView {
                        x: Tok.result-padding; y: Tok.result-padding;
                        width: parent.width - Tok.result-padding * 2; height: parent.height - Tok.result-padding * 2;
                        content-width: self.visible-width;
                        VerticalLayout {
                            width: parent.width; spacing: Tok.field-gap; alignment: start;
                            Text { text: "Dettaglio diagnostico"; color: Tok.ink; font-weight: Tok.semibold-weight; font-size: Tok.section-size; }
                            if root.selected < 0: Text { text: "Seleziona una riga per consultare causa, valori e dominio del campo."; color: Tok.muted; wrap: word-wrap; }
                            if root.selected >= 0: VerticalLayout {
                                spacing: Tok.field-gap; alignment: start;
                                Text { text: root.detail.code; color: Tok.error; font-family: Tok.mono; font-weight: Tok.semibold-weight; wrap: word-wrap; }
                                Text { text: root.detail.message; color: Tok.ink; wrap: word-wrap; line-height-factor: Tok.detail-line-height-factor; }
                                Rectangle { height: Tok.border-width; background: Tok.row-line; }
                                HorizontalLayout {
                                    spacing: Tok.field-gap;
                                    DetailValue { label: "Tracciato"; value: root.detail.trace; }
                                    DetailValue { label: "Riga / ID record"; value: root.detail.line + " / " + root.detail.record; }
                                }
                                DetailValue { label: "Campo / posizione in byte"; value: root.detail.field + " / " + root.detail.position + " / " + root.detail.field-name; }
                                DetailValue { label: "Valore letto · ␠ = spazio"; value: root.detail.actual; }
                                DetailValue { label: "Valore atteso"; value: root.detail.expected; }
                                Rectangle { height: Tok.border-width; background: Tok.row-line; }
                                DetailValue { label: "Dominio ammesso · consultazione a pagine"; value: root.domain-text; }
                                HorizontalLayout {
                                    spacing: Tok.picker-gap;
                                    ActionButton { label: "Primi valori"; activated => { root.restart-domain(); } }
                                    ActionButton { label: "Valori successivi"; enabled: root.domain-more; activated => { root.next-domain-page(); } }
                                }
                                DetailValue { label: "Contesto"; value: root.detail.context; }
                            }
                        }
                    }
                }
            }
            Text { text: root.note; color: root.error ? Tok.error : Tok.muted; font-size: Tok.caption-size; wrap: word-wrap; }
        }
    }
}
