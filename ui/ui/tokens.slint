import "fonts/IBMPlexSans-Regular.ttf";
import "fonts/IBMPlexSans-SemiBold.ttf";
import "fonts/IBMPlexSans-Bold.ttf";
import "fonts/IBMPlexMono-Regular.ttf";
import "fonts/IBMPlexMono-SemiBold.ttf";

// Unica fonte dei valori di design, derivati dal mockup.
export global Tok {
    in-out property <bool> dark-mode: false;
    out property <color> bg: root.dark-mode ? #0B0D0F : #F4F6F8;
    out property <color> surface: root.dark-mode ? #14181C : #FFFFFF;
    out property <color> ink: root.dark-mode ? #F4F6F8 : #14202B;
    out property <color> muted: root.dark-mode ? #B1BBC5 : #4A5B6B;
    out property <color> muted-on-dark: root.dark-mode ? #B1BBC5 : #9FB0C0;
    out property <color> border: root.dark-mode ? #64717D : #D9DEE5;
    out property <color> row-line: root.dark-mode ? #2B3239 : #E4E9EE;
    out property <color> header-bg: root.dark-mode ? #1D2329 : #EEF1F4;
    out property <color> accent: root.dark-mode ? #FF8A4C : #0F766E;
    out property <color> accent-tint: root.dark-mode ? #372117 : #E6F4F1;
    out property <color> error: root.dark-mode ? #FF7F70 : #B42318;
    out property <color> error-tint: root.dark-mode ? #3B1C1A : #FEE4E2;
    out property <color> warn: root.dark-mode ? #FFBA69 : #B54708;
    // Measured from the supplied 1280×780 canvas (2× source PNG).
    out property <length> table-width: 800px;
    out property <length> detail-width: 416px;
    out property <length> filter-code-width: 92px;
    out property <length> filter-field-width: 172px;
    out property <length> filter-record-width: 150px;
    out property <length> filter-fiscal-width: 172px;
    out property <length> filter-line-width: 100px;
    // Supplied IBM Plex hhea: (1025 - (-275))/1000 = 1.3em.
    // The mockup paragraph is 1.5em; Slint's factor multiplies the natural
    // line height, not font-size: 1.5 / 1.3, preserving the 14px glyph size.
    out property <float> detail-line-height-factor: 1.153846;
    out property <length> detail-meta-spacing: 7.1px;
    out property <length> detail-section-spacing: 9.5px;
    out property <string> sans: "IBM Plex Sans";
    out property <string> mono: "IBM Plex Mono";
    out property <color> nav-bg: root.dark-mode ? #0B0D0F : #16232E;
    out property <color> nav-ink: #FFFFFF;
    out property <color> nav-muted: root.dark-mode ? #B1BBC5 : #9FB0C0;
    out property <length> canvas-width: 1280px;
    out property <length> canvas-height: 780px;
    out property <length> min-width: 640px;
    out property <length> min-height: 480px;
    out property <length> page-padding: 24px;
    out property <length> header-height: 56px;
    out property <length> footer-height: 40px;
    out property <length> control-height: 36px;
    out property <length> choice-width: 80px;
    out property <length> info-width: 120px;
    out property <length> control-gap: 12px;
    out property <length> border-width: 1px;
    out property <length> focus-width: 2px;
    out property <length> control-radius: 6px;
    out property <length> body-size: 14px;
    out property <length> caption-size: 12px;
    out property <length> brand-size: 20px;
    out property <int> regular-weight: 400;
    out property <int> semibold-weight: 600;
    out property <int> bold-weight: 700;
    out property <length> about-width: 480px;
    out property <length> about-height: 240px;
}

