import "fonts/IBMPlexSans-Regular.ttf";
import "fonts/IBMPlexSans-SemiBold.ttf";
import "fonts/IBMPlexSans-Bold.ttf";
import "fonts/IBMPlexMono-Regular.ttf";
import "fonts/IBMPlexMono-SemiBold.ttf";

// Copper Ledger: single executable source for both themes.
// Geometry and colors implement docs/ui-design-documentation/LINTRA_DESIGN_DIRECTION.md; historic
// mockup values remain available in Git history before the documentation refactor.
export global Tok {
    in-out property <bool> dark-mode: false;
    out property <color> bg: root.dark-mode ? #101112 : #F5F4F0;
    out property <color> surface: root.dark-mode ? #1B1D1F : #FFFFFF;
    out property <color> ink: root.dark-mode ? #F5F4F0 : #20272B;
    out property <color> muted: root.dark-mode ? #B6BABC : #56616A;
    out property <color> muted-on-dark: root.dark-mode ? #B6BABC : #9FB0C0;
    out property <color> border: root.dark-mode ? #60676B : #CBCFCF;
    out property <color> row-line: root.dark-mode ? #34383A : #E3E5E2;
    out property <color> header-bg: root.dark-mode ? #25282B : #ECECE7;
    out property <color> accent: root.dark-mode ? #FF9C66 : #A13E1A;
    out property <color> accent-tint: root.dark-mode ? #392A21 : #F9EDE4;
    out property <color> error: root.dark-mode ? #FF9288 : #AE2925;
    out property <color> error-tint: root.dark-mode ? #3B2423 : #FCEDEA;
    out property <color> warn: root.dark-mode ? #EFC177 : #855408;
    out property <length> detail-width: 404px;
    // Supplied IBM Plex hhea: (1025 - (-275))/1000 = 1.3em.
    // The diagnostic paragraph is 1.5em; Slint's factor multiplies the natural
    // line height, not font-size: 1.5 / 1.3, preserving the 14px glyph size.
    out property <float> detail-line-height-factor: 1.153846;
    out property <length> detail-meta-spacing: 7.1px;
    out property <length> title-size: 28px;
    out property <length> space-small: 4px;
    out property <length> inspector-min-height: 480px;
    out property <length> results-title-height: 100px;
    out property <length> table-min-width: 704px;
    out property <color> on-accent: root.dark-mode ? #20272B : #FFFFFF;
    out property <color> accent-hover: root.dark-mode ? #FFB68C : #843115;
    out property <color> nav-selected: #363D40;
    out property <color> nav-focus: #FFB68C;
    out property <string> sans: "IBM Plex Sans";
    out property <string> mono: "IBM Plex Mono";
    out property <color> nav-bg: root.dark-mode ? #101112 : #20272B;
    out property <color> nav-ink: #FFFFFF;
    out property <color> nav-muted: root.dark-mode ? #B6BABC : #9FB0C0;
    out property <length> canvas-width: 1366px;
    out property <length> min-width: 640px;
    out property <length> min-height: 480px;
    out property <length> page-padding: 24px;
    out property <length> header-height: 64px;
    out property <length> footer-height: 28px;
    out property <length> control-height: 36px;
    out property <length> choice-width: 80px;
    out property <length> info-width: 120px;
    out property <length> control-gap: 12px;
    out property <length> border-width: 1px;
    out property <length> focus-width: 2px;
    out property <length> control-radius: 4px;
    out property <length> body-size: 14px;
    out property <length> caption-size: 12px;
    out property <length> brand-size: 22px;
    out property <length> brand-letter-spacing: -0.4px;
    out property <int> regular-weight: 400;
    out property <int> semibold-weight: 600;
    out property <int> bold-weight: 700;
    out property <length> about-width: 600px;
    out property <length> about-height: 340px;
    // Shared desktop geometry; page-specific field positions stay in the form.
    out property <length> analysis-height: 768px;
    out property <length> panel-gap: 24px;
    out property <length> card-padding: 24px;
    out property <length> card-radius: 6px;
    out property <length> analysis-intro-height: 112px;
    out property <length> configuration-height: 492px;
    out property <length> section-size: 18px;
    out property <length> field-padding: 10px;
    out property <length> field-gap: 16px;
    out property <length> chooser-width: 84px;
    out property <length> picker-gap: 8px;
    out property <length> icon-width: 12px;
    out property <length> icon-height: 8px;
    out property <length> icon-stroke: 1.5px;
    out property <length> item-height: 36px;
    out property <length> popup-max-height: 216px;
    out property <length> form-breakpoint: 1100px;
    out property <length> origin-width: 320px;
    out property <color> disabled-bg: root.dark-mode ? #1B1D1F : #ECECE7;
    out property <color> disabled-ink: root.dark-mode ? #A6ABAE : #606A70;
    out property <length> reports-width: 260px;
    out property <length> primary-action-width: 160px;
    out property <length> secondary-action-width: 120px;
    out property <length> browser-type-width: 90px;
    out property <length> browser-type-column: 100px;
    // Results: bounded virtual viewport, no production demo data.
    out property <length> result-row-height: 36px;
    out property <length> result-panel-gap: 16px;
    out property <length> result-padding: 16px;
    out property <length> result-empty-height: 102px;
    out property <length> result-line-width: 56px;
    out property <length> result-record-width: 90px;
    out property <length> result-field-width: 55px;
    out property <length> result-code-width: 180px;
}
