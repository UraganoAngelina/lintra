import { ScrollView } from "std-widgets.slint";
import { Tok } from "tokens.slint";
import { ActionButton, FieldEdit, ReportCheck } from "controls.slint";
export component ExportPanel inherits Rectangle {
    in property <string> run-label;
    in property <int> format;
    in-out property <string> destination;
    in property <string> note;
    in property <bool> busy;
    in property <bool> error;
    in property <bool> confirmation-required;
    in-out property <bool> overwrite;
    callback choose-format(int);
    callback path-edited();
    callback save();
    callback close();
    background: Tok.bg;
    ScrollView {
        width: parent.width; height: parent.height;
        content-width: self.visible-width;
        VerticalLayout {
            width: parent.width; padding: Tok.page-padding; spacing: Tok.panel-gap;
            alignment: start;
            Text { text: "Esporta report"; color: Tok.ink; font-size: Tok.section-size; font-weight: Tok.semibold-weight; }
            Text { text: root.run-label; color: Tok.muted; wrap: word-wrap; }
            HorizontalLayout {
                height: Tok.control-height; spacing: Tok.control-gap;
                ActionButton { label: "XLSX"; selected: root.format == 0; enabled: !root.busy; activated => { root.choose-format(0); } }
                ActionButton { label: "JSONL"; selected: root.format == 1; enabled: !root.busy; activated => { root.choose-format(1); } }
                ActionButton { label: "CSV"; selected: root.format == 2; enabled: !root.busy; activated => { root.choose-format(2); } }
            }
            VerticalLayout {
                spacing: Tok.detail-meta-spacing;
                Text { text: "File di destinazione"; color: Tok.ink; }
                FieldEdit { text <=> root.destination; enabled: !root.busy; placeholder: "Percorso completo del file"; edited(value) => { root.path-edited(); } confirmed(value) => { if !root.busy && (!root.confirmation-required || root.overwrite) { root.save(); } } }
                Text { text: "Il riepilogo verrà salvato accanto al report, aggiungendo .summary.json al nome."; color: Tok.muted; font-size: Tok.caption-size; wrap: word-wrap; }
            }
            if root.confirmation-required: ReportCheck { label: "Confermo la sostituzione dei file esistenti"; checked <=> root.overwrite; enabled: !root.busy; }
            Text { text: root.note; color: root.error ? Tok.error : Tok.ink; wrap: word-wrap; }
            HorizontalLayout {
                height: Tok.control-height; spacing: Tok.control-gap;
                Rectangle { horizontal-stretch: 1; }
                ActionButton { width: Tok.secondary-action-width; label: root.busy ? "Annulla" : "Chiudi"; activated => { root.close(); } }
                ActionButton { width: Tok.primary-action-width; label: "Salva report"; enabled: !root.busy && root.destination != "" && (!root.confirmation-required || root.overwrite); activated => { root.save(); } }
            }
        }
    }
}
